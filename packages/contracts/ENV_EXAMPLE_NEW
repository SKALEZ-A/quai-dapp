# ==========================================
# QUAI NETWORK DEPLOYMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file with real private keys

# ==========================================
# PRIVATE KEYS (NO 0x PREFIX)
# ==========================================
# Important: Each private key should correspond to an address 
# that starts with the appropriate zone prefix:
# - Cyprus1: 0x00... or 0x10...
# - Cyprus2: 0x01... or 0x11...
# - Paxos1: 0x02... or 0x12...
# - Hydra1: 0x06... or 0x16...

# Primary deployer key (used for single-zone deployments)
PRIVATE_KEY="your_private_key_here_no_0x_prefix"

# Zone-specific keys (for multi-zone deployments)
CYPRUS1_PK="your_cyprus1_private_key_no_0x"
CYPRUS2_PK="your_cyprus2_private_key_no_0x"
PAXOS1_PK="your_paxos1_private_key_no_0x"
HYDRA1_PK="your_hydra1_private_key_no_0x"

# ==========================================
# NETWORK CONFIGURATION
# ==========================================

# Chain ID
# - Mainnet: 9
# - Testnet (Orchard): 15000
# - Local: 1337
CHAIN_ID="9"

# RPC URL (Quai SDK will auto-route to correct zones with usePathing)
# Mainnet:
RPC_URL="https://rpc.quai.network"
QUAI_RPC_URL="https://rpc.quai.network"

# Testnet Orchard:
# RPC_URL="https://orchard.rpc.quai.network"
# QUAI_RPC_URL="https://orchard.rpc.quai.network"

# Local development:
# RPC_URL="http://localhost:8610"
# QUAI_RPC_URL="http://localhost:8610"

# ==========================================
# CONTRACT DEPLOYMENT ARGUMENTS
# ==========================================

# HelloQuai Contract
HELLO_GREETING="Hello from Quai Network!"

# QNS (Quai Name Service) Configuration
ADMIN_ADDRESS=""  # Leave empty to use deployer address

# Social Posts Contract
SOCIAL_POST_NAME="QuaiSocialPost"

# ==========================================
# OPTIONAL: IPFS/Storage Configuration
# ==========================================
WEB3_STORAGE_TOKEN=""

# ==========================================
# OPTIONAL: Block Explorer API Key
# ==========================================
EXPLORER_API_KEY=""
